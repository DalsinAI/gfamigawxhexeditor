+#elif defined( __WXOPENLAYOUT__ )
+// AmigaOS: files only. There is no ptrace, so no process memory, and a
+// file the program may not read is not owned by another user.
+bool FAL::OSDependedOpen(wxFileName& myfilename, FileAccessMode FAM, unsigned ForceBlockRW){
+	if(myfilename.GetFullPath().Lower().StartsWith( wxT("-pid="))){
+		wxMessageBox( _("Process memory cannot be opened on AmigaOS."),_("Error"), wxOK|wxICON_ERROR );
+		return false;
+		}
+	if( !myfilename.FileExists() ){
+		wxMessageBox(wxString(_("File does not exists at path:"))+wxT("\n")+myfilename.GetFullPath(),_("Error"), wxOK|wxICON_ERROR);
+		return false;
+		}
+	if( !myfilename.IsFileReadable() ){
+		wxMessageBox(wxString(_("File is not readable by permissions."))+wxT("\n")+myfilename.GetFullPath(),_("Error"), wxOK|wxICON_ERROR );
+		return false;
+		}
+	FileType=FAL_File;
+	return FALOpen(myfilename, FAM, ForceBlockRW);
+	}
+
 #elif defined( __WXOSX__ )
